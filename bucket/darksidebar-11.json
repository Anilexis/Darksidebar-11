{
    "version": "1.0.11",
    "description": "Modern hardware-accelerated multifunctional desktop sidebar for Rainmeter on Windows 11",
    "homepage": "https://github.com/Anilexis/Darksidebar-11",
    "license": "MIT",
    "url": "https://github.com/Anilexis/Darksidebar-11/releases/download/v1.0.11/Darksidebar-11-v1.0.11.rmskin",
    "hash": "AF41F3B2FE5F3032088B19787E79549CE6DE717B6A98EBB07C73C6F6478342D5",
    "installer": {
        "script": [
            "Add-Type -AssemblyName System.IO.Compression.FileSystem",
            "$rmskinPath = \"$dir\\Darksidebar-11-v$version.rmskin\"",
            "$zip = [System.IO.Compression.ZipFile]::OpenRead($rmskinPath)",
            "$skinsDest = \"$env:USERPROFILE\\Documents\\Rainmeter\\Skins\"",
            "$pluginsDest = \"$env:APPDATA\\Rainmeter\\Plugins\"",
            "if (-not (Test-Path $skinsDest)) { New-Item -ItemType Directory -Path $skinsDest -Force | Out-Null }",
            "if (-not (Test-Path $pluginsDest)) { New-Item -ItemType Directory -Path $pluginsDest -Force | Out-Null }",
            "foreach ($entry in $zip.Entries) {",
            "    if ($entry.FullName.StartsWith('Skins/')) {",
            "        $rel = $entry.FullName.Substring(6)",
            "        $target = Join-Path $skinsDest $rel",
            "        if (Test-Path $target) {",
            "            $isProtected = ($rel -like '*@Resources/Settings.inc*' -or $rel -like '*@Resources\\Settings.inc*' -or $rel -like '*@Resources/Cache/disks-*' -or $rel -like '*@Resources\\Cache\\disks-*' -or $rel -like '*@Resources/Cache/*-data.inc*' -or $rel -like '*@Resources\\Cache\\*status.inc*')",
            "            if ($isProtected) { continue }",
            "        }",
            "        if ($entry.FullName.EndsWith('/')) {",
            "            New-Item -ItemType Directory -Path $target -Force | Out-Null",
            "        } else {",
            "            New-Item -ItemType Directory -Path (Split-Path $target) -Force | Out-Null",
            "            try { [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $target, $true) } catch {}",
            "        }",
            "    } elseif ($entry.FullName -eq 'Plugins/64bit/NvBridge.dll') {",
            "        $targetPlugin = Join-Path $pluginsDest 'NvBridge.dll'",
            "        try { [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $targetPlugin, $true) } catch {}",
            "    }",
            "}",
            "$zip.Dispose()",
            "$skinBase = Join-Path $skinsDest 'Darksidebar-11'",
            "$userSettings = Join-Path $skinBase '@Resources\\Settings.inc'",
            "$defSettings = Join-Path $skinBase '@Resources\\Settings.default.inc'",
            "if (-not (Test-Path $userSettings) -and (Test-Path $defSettings)) {",
            "    Copy-Item $defSettings $userSettings -Force",
            "} elseif ((Test-Path $userSettings) -and (Test-Path $defSettings)) {",
            "    try {",
            "        $cp1251 = [System.Text.Encoding]::GetEncoding(1251)",
            "        $userText = [System.IO.File]::ReadAllText($userSettings, $cp1251)",
            "        $defLines = [System.IO.File]::ReadAllLines($defSettings, $cp1251)",
            "        $missing = @()",
            "        foreach ($line in $defLines) {",
            "            if ($line -match '^\\s*([A-Za-z0-9_]+)\\s*=') {",
            "                $k = $matches[1]",
            "                if ($userText -notmatch \"(?m)^\\s*$k\\s*=\") { $missing += $line }",
            "            }",
            "        }",
            "        if ($missing.Count -gt 0) {",
            "            $userText = $userText.TrimEnd() + \"`r`n`r`n; Newly added settings`r`n\" + ($missing -join \"`r`n\") + \"`r`n\"",
            "            [System.IO.File]::WriteAllText($userSettings, $userText, $cp1251)",
            "        }",
            "    } catch {}",
            "}",
            "$userDisks = Join-Path $skinBase '@Resources\\Cache\\disks-generated.inc'",
            "$defDisks = Join-Path $skinBase '@Resources\\Cache\\disks-generated.default.inc'",
            "if (-not (Test-Path $userDisks) -and (Test-Path $defDisks)) { Copy-Item $defDisks $userDisks -Force }",
            "$userVars = Join-Path $skinBase '@Resources\\Cache\\disks-vars.inc'",
            "$defVars = Join-Path $skinBase '@Resources\\Cache\\disks-vars.default.inc'",
            "if (-not (Test-Path $userVars) -and (Test-Path $defVars)) { Copy-Item $defVars $userVars -Force }",
            "$iniPath = \"$env:APPDATA\\Rainmeter\\Rainmeter.ini\"",
            "if (Test-Path $iniPath) {",
            "    $iniContent = [System.IO.File]::ReadAllText($iniPath, [System.Text.Encoding]::Unicode)",
            "    if ($iniContent -notmatch '\\[Darksidebar-11\\\\Sidebar\\]') {",
            "        $iniContent += \"`r`n`r`n[Darksidebar-11\\Sidebar]`r`nActive=1`r`nWindowX=2512`r`nWindowY=0`r`nClickThrough=0`r`nDraggable=0`r`nSnapEdges=1`r`nKeepOnScreen=1`r`nAlwaysOnTop=0`r`n\"",
            "        [System.IO.File]::WriteAllText($iniPath, $iniContent, [System.Text.Encoding]::Unicode)",
            "    } elseif ($iniContent -match '(?s)\\[Darksidebar-11\\\\Sidebar\\](.*?)Active=0') {",
            "        $iniContent = [System.Text.RegularExpressions.Regex]::Replace($iniContent, '(\\[Darksidebar-11\\\\Sidebar\\][\\s\\S]*?Active=)0', '${1}1')",
            "        [System.IO.File]::WriteAllText($iniPath, $iniContent, [System.Text.Encoding]::Unicode)",
            "    }",
            "}",
            "$rmExe = 'C:\\Program Files\\Rainmeter\\Rainmeter.exe'",
            "if (-not (Test-Path $rmExe)) { $rmExe = 'C:\\Program Files (x86)\\Rainmeter\\Rainmeter.exe' }",
            "if (Test-Path $rmExe) {",
            "    $proc = Get-Process -Name Rainmeter -ErrorAction SilentlyContinue",
            "    if ($proc) {",
            "        & $rmExe !RefreshApp",
            "        & $rmExe !ActivateConfig 'Darksidebar-11\\Sidebar' 'Sidebar.ini'",
            "    } else {",
            "        Start-Process $rmExe",
            "    }",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$skinsDest = \"$env:USERPROFILE\\Documents\\Rainmeter\\Skins\\Darksidebar-11\"",
            "if (Test-Path $skinsDest) { Remove-Item -Path $skinsDest -Recurse -Force -ErrorAction SilentlyContinue }",
            "$rmExe = 'C:\\Program Files\\Rainmeter\\Rainmeter.exe'",
            "if (-not (Test-Path $rmExe)) { $rmExe = 'C:\\Program Files (x86)\\Rainmeter\\Rainmeter.exe' }",
            "if (Test-Path $rmExe) {",
            "    & $rmExe !DeactivateConfig 'Darksidebar-11\\Sidebar'",
            "    & $rmExe !RefreshApp",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/Anilexis/Darksidebar-11/releases/download/v$version/Darksidebar-11-v$version.rmskin"
    }
}
